# Copia este archivo, renómbralo a ".env" (sin el ".example") y pon tus
# datos reales adentro. El ".env" real NUNCA se sube a GitHub (está en
# .gitignore) — ahí van tus credenciales de verdad.

# Correo para avisos (uno de estos 3 exactamente: gmail | outlook | office365)
EMAIL_SERVICE=gmail
EMAIL_USER=
# Para Gmail usa una "contraseña de aplicación", no tu contraseña normal.
EMAIL_PASS=
EMAIL_FROM_NOMBRE=Makand Rutograma
# Opcional: si el antivirus revisa los correos salientes y da error de
# certificado, pon true. Y si hace falta forzar un servidor/puerto:
EMAIL_IGNORAR_CERTIFICADO=
EMAIL_HOST=
EMAIL_PORT=
# A qué correos se permite enviar:
#   vacío o * = a cualquier correo
#   o una lista separada por comas: @gmail.com, @makand.com, pepe@hotmail.com
EMAIL_DESTINOS_PERMITIDOS=*
# Correos REALES que reciben los avisos del administrador (cuentas nuevas,
# cambios por aprobar, vencimientos), separados por coma.
EMAIL_AVISOS_ADMIN=
# Correos que reciben el resumen de vencimientos (si se deja vacío, va a
# EMAIL_AVISOS_ADMIN), separados por coma
EMAIL_VENCIMIENTOS_DESTINO=

# Sesiones. Por defecto toda petición necesita sesión (modo estricto).
# EXIGIR_TOKEN=false solo en una emergencia: acepta peticiones sin sesión,
# pero sin identidad (nadie puede hacerse pasar por otro).
EXIGIR_TOKEN=true
TOKEN_DIAS=30
# Opcional: si lo dejas vacío, el servidor usa data/secreto-sesion.key
AUTH_SECRET=

# Opcional: certificados para HTTPS
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=
